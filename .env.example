# Public browser configuration. Copy this file to .env.local and provide your own values.
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
NEXT_PUBLIC_PRIVY_APP_ID=replace_with_your_privy_app_id
NEXT_PUBLIC_OFFERING_ADDRESS=replace_after_deployment
NEXT_PUBLIC_KIRA_TOKEN_ADDRESS=replace_after_deployment
NEXT_PUBLIC_MARKETPLACE_ADDRESS=replace_after_deployment
NEXT_PUBLIC_DEPLOYMENT_BLOCK=replace_after_deployment

# Server-only infrastructure. Never expose these with a NEXT_PUBLIC_ prefix.
ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-an-authenticated-rpc.example
ARBISCAN_API_KEY=replace_with_your_arbiscan_api_key

# Deployment keys are intentionally absent. Use a Foundry encrypted keystore locally
# and GitHub Environment secrets in CI; never place a raw private key in an env file.

